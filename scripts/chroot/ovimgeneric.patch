+// ===== VSCode-like ranking + typo-tolerant matching =====
+
+// Deduplicate candidates: remove entries with same text but different keys
+void OVGenericContext::deduplicateCandidates(std::vector<std::string>& candidates) {
+    std::unordered_set<std::string> seen;
+    std::vector<std::string> result;
+    result.reserve(candidates.size());
+    for (const auto& cand : candidates) {
+        if (seen.insert(cand).second) {
+            result.push_back(cand);
+        }
+    }
+    candidates.swap(result);
+}
+
+// Locality bonus: track recently selected words for priority boost
+// (VSCode-like localityBonus). Words selected recently in the same session
+// get higher score.
+static const size_t MAX_RECENT_WORDS = 50;
+static std::deque<std::string> s_recentWords;
+static std::unordered_map<std::string, int> s_wordFrequency;
+
+void OVGenericContext::recordSelectedWord(const std::string& word) {
+    if (word.empty()) return;
+    s_wordFrequency[word]++;
+    auto it = std::find(s_recentWords.begin(), s_recentWords.end(), word);
+    if (it != s_recentWords.end()) {
+        s_recentWords.erase(it);
+    }
+    s_recentWords.push_front(word);
+    if (s_recentWords.size() > MAX_RECENT_WORDS) {
+        s_recentWords.pop_back();
+    }
+}
+
+int OVGenericContext::localityBonus(const std::string& word) const {
+    auto freqIt = s_wordFrequency.find(word);
+    if (freqIt != s_wordFrequency.end()) {
+        return -std::min(freqIt->second * 10, 100);
+    }
+    auto recentIt = std::find(s_recentWords.begin(), s_recentWords.end(), word);
+    if (recentIt != s_recentWords.end()) {
+        size_t pos = std::distance(s_recentWords.begin(), recentIt);
+        return -static_cast<int>(50 - pos * 2);
+    }
+    return 0;
+}
+
+void OVGenericContext::applyLocalityBonus(std::vector<std::string>& candidates) {
+    std::stable_sort(candidates.begin(), candidates.end(),
+        [this](const std::string& a, const std::string& b) {
+            int scoreA = localityBonus(a);
+            int scoreB = localityBonus(b);
+            if (scoreA != scoreB) return scoreA < scoreB;
+            return a < b;
+        });
+}
+
+// Subsequence scorer: every char of 'input' must appear in 'candidate' in
+// order (first char must match exactly). Higher = better; long consecutive
+// runs and exact-key hits win, skipped chars cost. -1 = no match.
+static int fuzzyScore(const std::string& candidate, const std::string& input)
+{
+    if (input.empty()) return 1;
+    if (candidate.empty() || candidate[0] != input[0]) return -1;
+
+    size_t candIdx = 0;
+    bool havePrev = false;
+    size_t prevPos = 0;
+    int score = 0;
+    int run = 0;
+    int bestRun = 0;
+
+    for (size_t i = 0; i < input.size(); ++i) {
+        bool found = false;
+        while (candIdx < candidate.size()) {
+            if (candidate[candIdx] == input[i]) { found = true; break; }
+            ++candIdx;
+        }
+        if (!found) return -1;
+
+        if (havePrev && candIdx == prevPos + 1) {
+            ++run;
+        } else {
+            if (havePrev)
+                score -= static_cast<int>(candIdx - prevPos - 1) * 2;
+            run = 1;
+        }
+        if (run > bestRun) bestRun = run;
+        havePrev = true;
+        prevPos = candIdx;
+        ++candIdx;
+    }
+
+    score += static_cast<int>(input.size()) * 10;
+    score += bestRun * 20;
+    if (candidate.size() == input.size()) score += 100;
+    return score > 0 ? score : 1;
+}
+
+// Banded Levenshtein with early abandon; -1 when the distance would exceed
+// maxDist. Used to correct pinyin/wubi typos ("jianjie" vs "jainjie").
+static int boundedEditDistance(const std::string& a, const std::string& b,
+                               int maxDist)
+{
+    const int la = static_cast<int>(a.size());
+    const int lb = static_cast<int>(b.size());
+    if (la - lb > maxDist || lb - la > maxDist) return -1;
+
+    std::vector<int> prev(lb + 1), cur(lb + 1);
+    for (int j = 0; j <= lb; ++j) prev[j] = j;
+
+    for (int i = 1; i <= la; ++i) {
+        const int lo = i > maxDist ? i - maxDist : 1;
+        const int hi = lb < i + maxDist ? lb : i + maxDist;
+
+        for (int j = 0; j <= lb; ++j) cur[j] = maxDist + 1;
+        cur[0] = i;
+
+        int rowMin = i;
+        for (int j = lo; j <= hi; ++j) {
+            const int cost = (a[i - 1] == b[j - 1]) ? 0 : 1;
+            int v = prev[j - 1] + cost;
+            if (prev[j] + 1 < v) v = prev[j] + 1;
+            if (cur[j - 1] + 1 < v) v = cur[j - 1] + 1;
+            cur[j] = v;
+            if (v < rowMin) rowMin = v;
+        }
+
+        if (rowMin > maxDist) return -1;
+        prev.swap(cur);
+    }
+
+    return prev[lb] <= maxDist ? prev[lb] : -1;
+}
+
+// Typo tolerance grows with sequence length: 1-2 keys exact-only,
+// 3-5 keys tolerate one edit, 6+ tolerate two.
+static int editDistanceThresholdFor(size_t len)
+{
+    if (len >= 6) return 2;
+    if (len >= 3) return 1;
+    return 0;
+}
+
+// ED matches rank below ANY subsequence match but stay ordered by distance.
+static const int FUZZY_ED_SCORE_BASE = 24;
+static const size_t FUZZY_MAX_RESULTS = 30;
+
+bool OVGenericContext::isWeakMatchEnabled() const {
+    return parent->isAutoCompose() || (cintab && !cintab->getSelKey().empty());
+}
+
+void OVGenericContext::getCandidatesWithFuzzy(const std::string& seq,
+                                              std::vector<std::string>& out) {
+    cintab->getWordVectorByCharWithWildcardSupport(seq, out,
+        parent->matchOneChar(), parent->matchZeroOrMoreChar());
+    deduplicateCandidates(out);
+
+    if (!isWeakMatchEnabled() || seq.empty()) return;
+
+    // getWordVectorByChar* only answers EXACT keys, so enumerate chardef
+    // keys directly and rank them: subsequence matches first (consecutive
+    // runs preferred), edit-distance corrections only as a last resort
+    // when nothing strict matched at all.
+    std::vector<std::pair<int, size_t> > scored;   // (score, chardef index)
+    const size_t n = cintab->getCharDefKeyCount();
+    const int edMax = editDistanceThresholdFor(seq.size());
+
+    for (size_t i = 0; i < n; ++i) {
+        const std::string& key = cintab->getCharDefKeyAt(i);
+        int sc = fuzzyScore(key, seq);
+        if (sc < 0 && out.empty() && edMax > 0) {
+            const int d = boundedEditDistance(seq, key, edMax);
+            if (d >= 0) sc = FUZZY_ED_SCORE_BASE - d * 10;
+        }
+        if (sc >= 0) scored.push_back(std::make_pair(sc, i));
+    }
+
+    if (scored.empty()) return;
+
+    std::stable_sort(scored.begin(), scored.end(),
+        [](const std::pair<int, size_t>& x, const std::pair<int, size_t>& y)
+        { return x.first > y.first; });
+
+    std::unordered_set<std::string> seen(out.begin(), out.end());
+    for (size_t i = 0; i < scored.size() && out.size() < FUZZY_MAX_RESULTS; ++i) {
+        std::vector<std::string> words;
+        cintab->getWordsForKeyAt(scored[i].second, words);
+        for (size_t w = 0; w < words.size(); ++w) {
+            if (seen.insert(words[w]).second) out.push_back(words[w]);
+            if (out.size() >= FUZZY_MAX_RESULTS) break;
+        }
+    }
+}
