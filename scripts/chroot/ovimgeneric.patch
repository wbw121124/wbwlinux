+// Deduplicate candidates: remove entries with same text but different keys
+void OVGenericContext::deduplicateCandidates(std::vector<std::string>& candidates) {
+    std::unordered_set<std::string> seen;
+    std::vector<std::string> result;
+    result.reserve(candidates.size());
+    for (const auto& cand : candidates) {
+        if (seen.insert(cand).second) {
+            result.push_back(cand);
+        }
+    }
+    candidates.swap(result);
+}
+
+// VSCode-like fuzzy matching (filterGraceful): subsequence matching
+// Input "zgs" matches key "zgysdl" (中国剩余定理) - characters in order but not necessarily contiguous
+bool OVGenericContext::fuzzyMatch(const std::string& key, const std::string& input) {
+    if (input.empty()) return true;
+    if (key.empty()) return false;
+    // First character must match (VSCode rule)
+    if (key[0] != input[0]) return false;
+    // Subsequence matching: all input chars must appear in key in order
+    size_t keyIdx = 0;
+    for (size_t i = 0; i < input.size(); ++i) {
+        bool found = false;
+        while (keyIdx < key.size()) {
+            if (key[keyIdx] == input[i]) {
+                found = true;
+                ++keyIdx;
+                break;
+            }
+            ++keyIdx;
+        }
+        if (!found) return false;
+    }
+    return true;
+}
+
+// Check if weak/fuzzy matching is enabled via ucimf config or parent settings
+bool OVGenericContext::isWeakMatchEnabled() const {
+    // Check ucimf prefix-match config or parent auto-compose settings
+    return parent->isAutoCompose() || (cintab && !cintab->getSelKey().empty());
+}
+
+// Get candidates with fuzzy matching fallback
+void OVGenericContext::getCandidatesWithFuzzy(const std::string& seq, std::vector<std::string>& out) {
+    // First try exact/wildcard match
+    cintab->getWordVectorByCharWithWildcardSupport(seq, out, parent->matchOneChar(), parent->matchZeroOrMoreChar());
+    
+    // If weak match enabled and few results, try fuzzy matching
+    if (isWeakMatchEnabled() && out.size() < 5) {
+        std::vector<std::string> fuzzyResults;
+        // Get all candidates for this key prefix (broader search)
+        cintab->getWordVectorByChar(seq, fuzzyResults);
+        for (const auto& cand : fuzzyResults) {
+            // The key is already the seq, so we check if the candidate's key would fuzzy match
+            // For now, just add all as fallback
+            if (std::find(out.begin(), out.end(), cand) == out.end()) {
+                out.push_back(cand);
+            }
+        }
+    }
+    deduplicateCandidates(out);
+}
