+// ===== VSCode-like features =====
+
+// Deduplicate candidates: remove entries with same text but different keys
+void OVGenericContext::deduplicateCandidates(std::vector<std::string>& candidates) {
+    std::unordered_set<std::string> seen;
+    std::vector<std::string> result;
+    result.reserve(candidates.size());
+    for (const auto& cand : candidates) {
+        if (seen.insert(cand).second) {
+            result.push_back(cand);
+        }
+    }
+    candidates.swap(result);
+}
+
+// Locality bonus: track recently selected words for priority boost (VSCode-like localityBonus)
+// Words selected recently in the same session get higher score
+static const size_t MAX_RECENT_WORDS = 50;
+static std::deque<std::string> s_recentWords;
+static std::unordered_map<std::string, int> s_wordFrequency;
+
+void OVGenericContext::recordSelectedWord(const std::string& word) {
+    if (word.empty()) return;
+    s_wordFrequency[word]++;
+    auto it = std::find(s_recentWords.begin(), s_recentWords.end(), word);
+    if (it != s_recentWords.end()) {
+        s_recentWords.erase(it);
+    }
+    s_recentWords.push_front(word);
+    if (s_recentWords.size() > MAX_RECENT_WORDS) {
+        s_recentWords.pop_back();
+    }
+}
+
+int OVGenericContext::localityBonus(const std::string& word) const {
+    auto freqIt = s_wordFrequency.find(word);
+    if (freqIt != s_wordFrequency.end()) {
+        return -std::min(freqIt->second * 10, 100);
+    }
+    auto recentIt = std::find(s_recentWords.begin(), s_recentWords.end(), word);
+    if (recentIt != s_recentWords.end()) {
+        size_t pos = std::distance(s_recentWords.begin(), recentIt);
+        return -static_cast<int>(50 - pos * 2);
+    }
+    return 0;
+}
+
+void OVGenericContext::applyLocalityBonus(std::vector<std::string>& candidates) {
+    std::stable_sort(candidates.begin(), candidates.end(),
+        [this](const std::string& a, const std::string& b) {
+            int scoreA = localityBonus(a);
+            int scoreB = localityBonus(b);
+            if (scoreA != scoreB) return scoreA < scoreB;
+            return a < b;
+        });
+}
+
+bool OVGenericContext::fuzzyMatch(const std::string& candidate, const std::string& input) {
+    if (input.empty()) return true;
+    if (candidate.empty()) return false;
+    if (candidate[0] != input[0]) return false;
+    size_t candIdx = 0;
+    for (size_t i = 0; i < input.size(); ++i) {
+        bool found = false;
+        while (candIdx < candidate.size()) {
+            if (candidate[candIdx] == input[i]) {
+                found = true;
+                ++candIdx;
+                break;
+            }
+            ++candIdx;
+        }
+        if (!found) return false;
+    }
+    return true;
+}
+
+bool OVGenericContext::isWeakMatchEnabled() const {
+    return parent->isAutoCompose() || (cintab && !cintab->getSelKey().empty());
+}
+
+void OVGenericContext::getCandidatesWithFuzzy(const std::string& seq, std::vector<std::string>& out) {
+    cintab->getWordVectorByCharWithWildcardSupport(seq, out, parent->matchOneChar(), parent->matchZeroOrMoreChar());
+    
+    if (isWeakMatchEnabled() && out.size() < 5) {
+        std::vector<std::string> fuzzyResults;
+        cintab->getWordVectorByChar(seq, fuzzyResults);
+        for (const auto& cand : fuzzyResults) {
+            if (fuzzyMatch(cand, seq)) {
+                if (std::find(out.begin(), out.end(), cand) == out.end()) {
+                    out.push_back(cand);
+                }
+            }
+        }
+    }
+    deduplicateCandidates(out);
+}
